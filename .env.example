# 클라이언트에 노출됨 (NEXT_PUBLIC_*) — anon key는 RLS 통과를 전제로 한 일반 접근용
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 서버 전용. 절대 클라이언트 컴포넌트/번들에 반입 금지 (RLS 우회 가능)
SUPABASE_SERVICE_ROLE_KEY=

# 서버 전용. Resend 발송 API 키
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@ticket-system.example

# NODE_ENV=production이 아닐 때(local/staging) 모든 발송 메일을 이 주소로만 보낸다.
# 스테이징에서 실제 직원에게 메일이 나가는 사고를 막기 위한 안전장치 — 값이 없으면 발송이 실패한다.
STAGING_TEST_EMAIL=
